<?xml version="1.0" encoding="utf-8"?>
<!--
  screen_predict.xml — экран «Предикт HyperOS 4»
  Верхняя часть: название устройства + плашка получит/не получит
  Нижняя шторка: полный список устройств (свайп вверх)
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080C14">

    <com.pocotech.hub.AuroraBackground
        android:id="@+id/predict_bg_anim"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- ════ ОСНОВНОЙ КОНТЕНТ ════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <!-- Версия OS: подставляется динамически через predict_os_label -->
        <TextView
            android:id="@+id/predict_os_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/predict_os_version"
            android:textColor="#60A0C8FF"
            android:textSize="13sp"
            android:letterSpacing="0.15"
            android:layout_marginBottom="6dp" />

        <!-- Маркетинговое название устройства -->
        <TextView
            android:id="@+id/predict_device_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ваше устройство"
            android:textColor="#FFFFFF"
            android:textSize="32sp"
            android:textStyle="bold"
            android:gravity="center"
            android:letterSpacing="-0.02"
            android:layout_marginBottom="6dp" />

        <!-- Модель (серым) -->
        <TextView
            android:id="@+id/predict_device_model"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#506080"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_marginBottom="32dp" />

        <!-- Плашка: получит / не получит -->
        <LinearLayout
            android:id="@+id/predict_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:background="@drawable/predict_badge_bg"
            android:layout_marginBottom="48dp"
            android:contentDescription="@string/predict_badge_desc">

            <TextView
                android:id="@+id/predict_badge_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:layout_marginEnd="10dp"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/predict_badge_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Подсказка свайпа: opacity повышена до 80% для читаемости -->
        <LinearLayout
            android:id="@+id/predict_swipe_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/predict_show_list"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="↑"
                android:textColor="#80FFFFFF"
                android:textSize="20sp"
                android:gravity="center"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/predict_show_list"
                android:textColor="#80FFFFFF"
                android:textSize="11sp"
                android:letterSpacing="0.05"
                android:importantForAccessibility="no" />
        </LinearLayout>

    </LinearLayout>

    <!-- ════ ШТОРКА СО СПИСКОМ (изначально скрыта снизу) ════ -->
    <FrameLayout
        android:id="@+id/predict_sheet_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:contentDescription="@string/predict_close_list"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/predict_sheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="bottom"
        android:layout_marginTop="48dp"
        android:orientation="vertical"
        android:background="@drawable/predict_sheet_bg"
        android:translationY="2000dp">

        <!-- Ручка -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="16dp"
            android:background="#30FFFFFF" />

        <!-- Заголовок шторки -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/predict_sheet_title"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginStart="20dp"
            android:layout_marginBottom="4dp" />

        <!-- Предупреждение -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#1AFFCC00"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_warning"
                android:layout_marginEnd="8dp"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/predict_disclaimer"
                android:textColor="#FFCC00"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Список устройств -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="88dp">

            <LinearLayout
                android:id="@+id/predict_device_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </ScrollView>
    </LinearLayout>

</FrameLayout>
