<?xml version="1.0" encoding="utf-8"?>
<!--
  screen_settings.xml v2.0.0.0
  ПЕРЕДЕЛАН в экран "О приложении" в стиле HyperCeiler.
  Старые настройки (Liquid Glass, тема, вибрация, сброс, терминал) убраны —
  бэкап в screen_settings_OLD_backup.xml, вернуть на отдельный экран позже.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080C14">

    <com.pocotech.hub.AuroraBackground
        android:id="@+id/bg_anim"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingTop="24dp"
            android:paddingBottom="100dp">

            <!-- ════ HERO: иконка + название + версия ════ -->
            <ImageView
                android:id="@+id/about_app_icon"
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:src="@drawable/poco_icon"
                android:contentDescription="HyperHub" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="HyperHub"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginTop="14dp" />

            <TextView
                android:id="@+id/about_version"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Версия 1.3.3.2"
                android:textColor="#505060"
                android:textSize="12sp"
                android:gravity="center"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="20dp" />

            <!-- ════ КАРТОЧКА УСТРОЙСТВА ════ -->
            <com.pocotech.hub.HyperCard
                android:id="@+id/card_about_device"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp"
                android:layout_marginBottom="20dp">

                <TextView
                    android:id="@+id/about_device_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Xiaomi POCO C65"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="10dp">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/about_device_codename"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="POCO C65"
                            android:textColor="#D0D4E0"
                            android:textSize="13sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Устройство"
                            android:textColor="#505060"
                            android:textSize="10sp"
                            android:layout_marginTop="1dp" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#1AFFFFFF"
                    android:layout_marginBottom="10dp" />

                <LinearLayout
                    android:id="@+id/about_android_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="10dp"
                    android:clickable="true"
                    android:focusable="true">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/about_android_version"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="15"
                            android:textColor="#D0D4E0"
                            android:textSize="13sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Версия Android"
                            android:textColor="#505060"
                            android:textSize="10sp"
                            android:layout_marginTop="1dp" />
                        <TextView
                            android:id="@+id/about_easter_hint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:visibility="gone"
                            android:textColor="#5F82C7"
                            android:textSize="10sp"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#1AFFFFFF"
                    android:layout_marginBottom="10dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/about_os_version"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="OS2.0.204.0.VGPRUXM"
                            android:textColor="#D0D4E0"
                            android:textSize="13sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Версия ОС"
                            android:textColor="#505060"
                            android:textSize="10sp"
                            android:layout_marginTop="1dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.pocotech.hub.HyperCard>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ЯЗЫК И ИНТЕРФЕЙС"
                android:textColor="#506070"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:layout_marginBottom="8dp"
                android:layout_marginLeft="4dp" />

            <com.pocotech.hub.HyperCard
                android:id="@+id/card_language"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginRight="12dp"
                    android:src="@drawable/ic_globe"
                    android:tint="#8EB1FF" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Язык приложения"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Выберите язык интерфейса"
                        android:textColor="#505060"
                        android:textSize="11sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/language_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="English"
                    android:textColor="#8EB1FF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginRight="10dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="#8090D0"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </com.pocotech.hub.HyperCard>

            <com.pocotech.hub.HyperCard
                android:id="@+id/card_toggle_bg_anim"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Фоновые анимации"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Aurora-эффекты на экранах"
                        android:textColor="#505060"
                        android:textSize="11sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <com.pocotech.hub.ToggleView
                    android:id="@+id/toggle_bg_anim"
                    android:layout_width="52dp"
                    android:layout_height="30dp" />
            </com.pocotech.hub.HyperCard>

            <com.pocotech.hub.HyperCard
                android:id="@+id/card_toggle_haptic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Тактильный отклик"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Вибрация при нажатиях"
                        android:textColor="#505060"
                        android:textSize="11sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <com.pocotech.hub.ToggleView
                    android:id="@+id/toggle_haptic"
                    android:layout_width="52dp"
                    android:layout_height="30dp" />
            </com.pocotech.hub.HyperCard>

            <com.pocotech.hub.HyperCard
                android:id="@+id/card_toggle_splash"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Заставка при запуске"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Показывать интро HyperHub"
                        android:textColor="#505060"
                        android:textSize="11sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <com.pocotech.hub.ToggleView
                    android:id="@+id/toggle_splash"
                    android:layout_width="52dp"
                    android:layout_height="30dp" />
            </com.pocotech.hub.HyperCard>

            <!-- ════ РАЗРАБОТЧИК ════ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="РАЗРАБОТЧИК"
                android:textColor="#506070"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:layout_marginBottom="8dp"
                android:layout_marginLeft="4dp" />

            <com.pocotech.hub.HyperCard
                android:id="@+id/card_developer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="14dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="20dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/dev_avatar"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginRight="12dp"
                    android:src="@drawable/xiaot"
                    android:contentDescription="XiaoT" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="XiaoT"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@XiaoC65"
                        android:textColor="#505060"
                        android:textSize="11sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="#8090D0"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </com.pocotech.hub.HyperCard>

            <!-- ════ ОБСУЖДЕНИЕ ════ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ОБСУЖДЕНИЕ"
                android:textColor="#506070"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:layout_marginBottom="8dp"
                android:layout_marginLeft="4dp" />

            <com.pocotech.hub.HyperCard
                android:id="@+id/card_telegram_channel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="20dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginRight="12dp"
                    android:src="@drawable/ic_telegram"
                    android:contentDescription="Telegram" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Telegram Канал"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Новости и обновления HyperHub"
                        android:textColor="#505060"
                        android:textSize="11sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="#8090D0"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </com.pocotech.hub.HyperCard>

            <!-- ════ ПРОЧЕЕ ════ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ПРОЧЕЕ"
                android:textColor="#506070"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:layout_marginBottom="8dp"
                android:layout_marginLeft="4dp" />

            <com.pocotech.hub.HyperCard
                android:id="@+id/card_donate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginRight="12dp"
                    android:src="@drawable/ic_donate"
                    android:tint="#FFD700"
                    android:contentDescription="Донаты" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Донаты"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Вы можете поддержать разработку"
                        android:textColor="#505060"
                        android:textSize="11sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="#8090D0"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </com.pocotech.hub.HyperCard>

            <com.pocotech.hub.HyperCard
                android:id="@+id/card_privacy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="20dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginRight="12dp"
                    android:src="@drawable/ic_lock"
                    android:tint="#8EB1FF" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Политика конфиденциальности"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Какие данные собирает приложение"
                        android:textColor="#505060"
                        android:textSize="11sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="#8090D0"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </com.pocotech.hub.HyperCard>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="© 2026 XiaoT &amp; HyperHub"
                android:textColor="#405060"
                android:textSize="11sp"
                android:gravity="center"
                android:layout_marginTop="4dp" />

        </LinearLayout>
    </ScrollView>
</FrameLayout>
