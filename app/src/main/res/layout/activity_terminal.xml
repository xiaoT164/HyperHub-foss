<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hh_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Terminal (offline)"
        android:textColor="@color/hh_text_secondary"
        android:textSize="13sp" />

    <ScrollView
        android:id="@+id/scrollOutput"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:background="#CC111827">
        <TextView
            android:id="@+id/tvOutput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:textColor="@color/hh_text_primary"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:text="Terminal is disabled in FOSS build. Use Termux or ADB Shell." />
    </ScrollView>

    <EditText
        android:id="@+id/etCommand"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="adb shell command"
        android:padding="12dp"
        android:layout_marginTop="8dp"
        android:textColor="@color/hh_text_primary"
        android:textColorHint="@color/hh_text_secondary"
        android:background="#CC111827"
        android:inputType="text" />

</LinearLayout>
