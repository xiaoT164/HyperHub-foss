<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080C14">

    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.pocotech.hub.HyperNavBar
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_gravity="bottom"
        android:layout_marginLeft="14dp"
        android:layout_marginRight="14dp"
        android:layout_marginBottom="14dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingLeft="6dp"
        android:paddingRight="6dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <LinearLayout
            android:id="@+id/nav_home"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <View
                android:id="@+id/nav_home_indicator"
                android:layout_width="22dp"
                android:layout_height="4dp"
                android:layout_marginBottom="6dp"
                android:alpha="0"
                android:background="@drawable/nav_indicator" />

            <ImageView
                android:id="@+id/nav_home_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@android:drawable/ic_menu_view"
                android:tint="#FFFFFFFF" />

            <TextView
                android:id="@+id/nav_home_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Главная"
                android:textColor="#FF8A8A8F"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_updates"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <View
                android:id="@+id/nav_updates_indicator"
                android:layout_width="22dp"
                android:layout_height="4dp"
                android:layout_marginBottom="6dp"
                android:alpha="0"
                android:background="@drawable/nav_indicator" />

            <ImageView
                android:id="@+id/nav_updates_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@android:drawable/ic_popup_sync"
                android:tint="#FF8A8A8F" />

            <TextView
                android:id="@+id/nav_updates_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Обновл."
                android:textColor="#FF8A8A8F"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_info"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <View
                android:id="@+id/nav_info_indicator"
                android:layout_width="22dp"
                android:layout_height="4dp"
                android:layout_marginBottom="6dp"
                android:alpha="0"
                android:background="@drawable/nav_indicator" />

            <ImageView
                android:id="@+id/nav_info_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@android:drawable/ic_menu_info_details"
                android:tint="#FF8A8A8F" />

            <TextView
                android:id="@+id/nav_info_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Инфо"
                android:textColor="#FF8A8A8F"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- BENCHMARK -->
        <LinearLayout
            android:id="@+id/nav_benchmark"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <View
                android:id="@+id/nav_benchmark_indicator"
                android:layout_width="22dp"
                android:layout_height="4dp"
                android:layout_marginBottom="6dp"
                android:alpha="0"
                android:background="@drawable/nav_indicator" />

            <ImageView
                android:id="@+id/nav_benchmark_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@android:drawable/ic_menu_compass"
                android:tint="#FF8A8A8F" />

            <TextView
                android:id="@+id/nav_benchmark_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Тест"
                android:textColor="#FF8A8A8F"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_predict"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <View
                android:id="@+id/nav_predict_indicator"
                android:layout_width="22dp"
                android:layout_height="4dp"
                android:layout_marginBottom="6dp"
                android:alpha="0"
                android:background="@drawable/nav_indicator" />

            <ImageView
                android:id="@+id/nav_predict_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@android:drawable/ic_menu_search"
                android:tint="#FF8A8A8F" />

            <TextView
                android:id="@+id/nav_predict_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Predict"
                android:textColor="#FF8A8A8F"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_settings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <View
                android:id="@+id/nav_settings_indicator"
                android:layout_width="22dp"
                android:layout_height="4dp"
                android:layout_marginBottom="6dp"
                android:alpha="0"
                android:background="@drawable/nav_indicator" />

            <ImageView
                android:id="@+id/nav_settings_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@android:drawable/ic_menu_preferences"
                android:tint="#FF8A8A8F" />

            <TextView
                android:id="@+id/nav_settings_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Настройки"
                android:textColor="#FF8A8A8F"
                android:textSize="9sp" />
        </LinearLayout>

        <!-- ПРОФИЛИ (2.0.0) -->
        <LinearLayout
            android:id="@+id/nav_profiles"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <View
                android:id="@+id/nav_profiles_indicator"
                android:layout_width="18dp"
                android:layout_height="4dp"
                android:layout_marginBottom="6dp"
                android:alpha="0"
                android:background="@drawable/nav_indicator" />

            <ImageView
                android:id="@+id/nav_profiles_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@android:drawable/ic_menu_manage"
                android:tint="#FF8A8A8F" />

            <TextView
                android:id="@+id/nav_profiles_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Профили"
                android:textColor="#FF8A8A8F"
                android:textSize="9sp" />
        </LinearLayout>

        <!-- НАГРАДЫ (2.0.0) -->
        <LinearLayout
            android:id="@+id/nav_achievements"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <View
                android:id="@+id/nav_achievements_indicator"
                android:layout_width="18dp"
                android:layout_height="4dp"
                android:layout_marginBottom="6dp"
                android:alpha="0"
                android:background="@drawable/nav_indicator" />

            <ImageView
                android:id="@+id/nav_achievements_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@android:drawable/btn_star_big_off"
                android:tint="#FF8A8A8F" />

            <TextView
                android:id="@+id/nav_achievements_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Награды"
                android:textColor="#FF8A8A8F"
                android:textSize="9sp" />
        </LinearLayout>

    </com.pocotech.hub.HyperNavBar>

</FrameLayout>